# Copy to brain/.env. NEVER commit brain/.env -- it holds the FESCO
# reference number, which must never reach Firebase, git, or logs.

# Firebase (service account, full read/write access -- keep this file private)
FIREBASE_DATABASE_URL=https://wifi-324bd-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Google Gemini (free tier, vision + PDF support) for bill parsing in
# import_bill.py, and report.py's AI text. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models if this stops working.
GEMINI_MODEL=gemini-3.1-flash-lite

# FESCO bill account reference number (14 digits). ONLY ever read from this
# file. Never printed in full, never written to Firebase, never committed.
REFERENCE_NUMBER=
